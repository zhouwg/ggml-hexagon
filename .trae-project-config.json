{
  "project": "ggml-hexagon",
  "local_workdir": "/home/zhouwg/develop/ggml-hexagon",
  "remote_build_host": "zhouwg@192.168.0.200",
  "remote_workdir": "/home/zhouwg/develop/ggml-hexagon",
  "scripts": {
    "build": "cd /home/zhouwg/develop/ggml-hexagon/ && ./scripts/build-run-android.sh build",
    "ut": "cd /home/zhouwg/develop/ggml-hexagon/ && ./scripts/build-run-android.sh run_llamacli 3"
  },
  "commands": {
    "verify_build": "ssh zhouwg@192.168.0.200 \"cd /home/zhouwg/develop/ggml-hexagon/ && ./scripts/build-run-android.sh build\"",
    "run_ut": "ssh zhouwg@192.168.0.200 \"cd /home/zhouwg/develop/ggml-hexagon/ && ./scripts/build-run-android.sh run_llamacli 3\""
