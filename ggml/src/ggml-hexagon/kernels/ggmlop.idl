#include "AEEStdDef.idl"
#include "remote.idl"

//not acutually used at the moment

const string IDL_VERSION = "0.0.1";

struct dsptensor {
    int32_t type;
    int32_t ne[4];
    int32_t nb[4];
    int32_t op;
    int32_t op_params[16];
    int32_t flags;
    sequence<float> data;
};

// Tensor descriptor
struct dsp_tensor_desc {
    int32_t type;          // data type
    int32_t ne[4];         // dimensions
    int32_t nb[4];         // strides in bytes
    int64_t va;            // AP-side virtual address
    int32_t fd;            // ION file descriptor
    int32_t size;          // data size in bytes
};

// Op descriptor
struct dsp_op_desc {
    int32_t opcode;        // GGML_OP type
    int32_t params[16];    // op parameters
    int32_t src0_idx;      // tensor index (-1 if none)
    int32_t src1_idx;      // tensor index (-1 if none)
    int32_t dst_idx;       // tensor index
};

// Batch request
struct dsp_opbatch_req {
    int32_t n_tensors;     // number of tensors
    int32_t n_ops;         // number of ops
    sequence<dsp_tensor_desc> tensors;
    sequence<dsp_op_desc> ops;
};

interface ggmlop : remote_handle64 {
   AEEResult dsp_setclocks(in int32 power_level,in int32 latency,in int32 mulmat_algotype, in int32 thread_counts);
   long      dsp_add(in dsptensor src0, in dsptensor src1, rout dsptensor dst);
   long      dsp_mulmat(in dsptensor src0, in dsptensor src1, rout dsptensor dst);
   long      dsp_execute_task(in int32 ggml_op_type, in dsptensor src0, in dsptensor src1, rout dsptensor dst);
   AEEResult dsp_execute_batch(in dsp_opbatch_req req);
};
